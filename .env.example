# Copia para .env e muda os valores. O .env nunca é commitado.
# Estes valores são só para desenvolvimento local.

# Superutilizador do PostgreSQL local (só usado pelo docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troca-me-superuser
POSTGRES_DB=loja

# Papéis da aplicação (ver docs/architecture/data-model.md).
# Usa só letras, números e hífenes: estas palavras-passe entram em URLs.
DB_MIGRATOR_PASSWORD=troca-me-migrator
DB_APP_PASSWORD=troca-me-app
DB_READONLY_PASSWORD=troca-me-readonly

# Ligações usadas pela API e pelas migrações
DATABASE_URL=postgres://app:troca-me-app@localhost:5432/loja?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://migrator:troca-me-migrator@localhost:5432/loja?sslmode=disable

# Palavra-passe das contas de teste criadas por `make dev-users`
# (gestor@loja.test e funcionario@loja.test). Pelo menos 12 caracteres.
DEV_USER_PASSWORD=troca-me-dev-local

# Sem chave, a API local usa uma temporária para os access tokens (as
# sessões renovam-se sozinhas depois de reiniciar). Para fixar uma, gera-a
# com `make jwt-key` e descomenta:
# JWT_SIGNING_KEY=
